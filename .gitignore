# Build output
build/
*.o
*.a
*.obj
*.lib

# Compiled binaries. This list exists because it didn't: with no *.dll rule a
# stale deki-engine.dll was committed and sat in the repo for months.
*.dll
*.so
*.dylib
*.exe
*.pdb
*.exp
*.ilk

# Editor / IDE
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.claude/

# Scratch
*.tmp
*.log

# Generated property metadata (auto-generated by the reflection codegen).
# The .gen.cpp files ARE tracked; these headers are not.
include/deki/generated/*.gen.h
